{
  "name": "uploadfit",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Local image and audio adaptation for browser upload controls in Tabbit Browser.",
  "type": "module",
  "engines": {
    "node": ">=22.20.0",
    "npm": ">=10.9.3"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "static-check": "node scripts/static-check.js",
    "check": "npm run build && npm run static-check && node scripts/check-release.mjs",
    "release": "npm run check && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "lamejs": "1.2.1"
  },
  "author": "TenrocZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TenrocZ/uploadfit.git"
  },
  "homepage": "https://github.com/TenrocZ/uploadfit#readme",
  "bugs": {
    "url": "https://github.com/TenrocZ/uploadfit/issues"
  },
  "keywords": [
    "tabbit",
    "upload",
    "image",
    "audio",
    "privacy"
  ]
}
